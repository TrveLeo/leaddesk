# Banco. Postgres em produção; SQLite serve para demonstração e testes.
DATABASE_URL=postgresql://leaddesk:leaddesk@localhost:5432/leaddesk

# Notificação de follow-up (opcional — sem token, o job só imprime no log)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Agendamento diário do job de follow-up
FOLLOWUP_JOB_HOUR=8
FOLLOWUP_JOB_MINUTE=0
FOLLOWUP_DAYS_AHEAD=1
